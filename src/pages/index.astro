---
import quotes from '../data/quotes.json';

const quote = quotes[Math.floor(Math.random() * quotes.length)];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quote</title>
    <style>
      :root {
        color-scheme: dark;
      }

      html,
      body {
        height: 100%;
        margin: 0;
      }

      body {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem;
        box-sizing: border-box;
        background-color: #12141a;
        color: #f5f5f7;
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          system-ui,
          'Segoe UI',
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
      }

      .quote {
        max-width: 40rem;
        text-align: center;
      }

      .quote-text {
        margin: 0;
        font-size: 1.75rem;
        line-height: 1.4;
      }

      .quote-author {
        margin: 1rem 0 0;
        font-size: 1rem;
        color: #f5f5f7;
        opacity: 0.5;
      }
    </style>
  </head>
  <body>
    <figure class="quote">
      <blockquote class="quote-text">
        <p>{quote.text}</p>
      </blockquote>
      <figcaption class="quote-author">{quote.author}</figcaption>
    </figure>
  </body>
</html>
