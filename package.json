{
  "name": "buildboard-notes",
  "version": "0.1.0",
  "description": "A single-window desktop notes app that auto-saves as you type.",
  "main": "./out/main/index.js",
  "author": {
    "name": "BuildBoard",
    "email": "engineering@buildboard.dev"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --linux --win --publish=never",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.buildboard.notes",
    "productName": "BuildBoard Notes",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "publish": null,
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
